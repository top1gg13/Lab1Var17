# Скомпилированные файлы, которые Python создаёт сам при запуске
__pycache__/
*.py[cod]
*.pyo

# ---------- виртуальное окружение ----------
# библиотеки, установленные для проекта (у каждого свои)
venv/
.venv/
env/

# ---------- PyCharm ----------
# личные настройки среды разработки
.idea/

# ---------- VS Code ----------
.vscode/

# ---------- служебные файлы систем ----------
# Windows
Thumbs.db
desktop.ini
# macOS
.DS_Store

# ---------- временные файлы ----------
*.log
*.tmp
*.bak
~$*

# ---------- draw.io ----------
# резервные копии, которые draw.io создаёт рядом с диаграммой
*.drawio.bkp
.$*.drawio
